---
import ImageLazy from "@components/extras/ImageLazy.astro";
import "./logo.css"
const {
  animationdirection = "fade-right",
  textColor = "[--secundary-color]",
  fontSize = "",
  fontSizeSlogan = "",
  isMobile = false,
  isFooter = false
} = Astro.props;
---

{
  isMobile ? (
    <a
      data-aos={animationdirection}
      href="/"
      class={`flex   flex-col pt-1 font-normal  relative w-40 ${!isFooter ? "min-w-[25%] md:min-w-[35%]" : "min-w-[25%] "} ` }
    >
        <ImageLazy
            // src="/img/logo/logo-dark.svg "
            src="/img/logo/nearShoringLogoWhite.svg"
            width="100"
            height="114"
            className=" relative pt-[32%] w-40"
            classNameImage="logo__img  logo__img--mobile h-full object-contain"
            slot="image"
          />
    </a>
  ) : (
    <a data-aos={animationdirection} href="/" class={`logo hidden md:flex flex-col w-[70%] max-w-[50rem] 2xl:max-w-[55rem]`}>
      <ImageLazy
            // src="/img/logo/logo-light.svg"
            src="/img/logo/nearShoringLogoBlack.svg"
            width="200"
            height="114"
            className="pt-[30%] relative "
            classNameImage="logo__img logo__img--light h-full  object-contain"
            slot="image"
          />
      <ImageLazy
            // src="/img/logo/logo-dark.svg"
            src="/img/logo/nearShoringLogoWhite.svg"
            width="200"
            height="114"
            className="pt-[30%] relative "
            classNameImage="logo__img logo__img--dark  h-full  object-contain"
            slot="image"
          />
    </a>
  )
}